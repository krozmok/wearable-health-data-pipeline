        <mxCell id="brzNote" value="&lt;b&gt;Raw, as delivered&lt;/b&gt;&lt;br&gt;- One table per source file type&lt;br&gt;- Append-only, one load per daily batch&lt;br&gt;- No cleaning or type changes&lt;br&gt;- Adds load date and source file&lt;br&gt;- Kept so Silver can be rebuilt" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=4;" vertex="1" parent="brz">
          <mxGeometry x="15" y="345" width="200" height="200" as="geometry" />
