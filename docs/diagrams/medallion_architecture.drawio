          <mxGeometry x="15" y="124" width="200" height="34" as="geometry" />
        </mxCell>
        <mxCell id="brz4" value="sleep (nested stages)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5E3CF;strokeColor=#B5651D;" vertex="1" parent="brz">
