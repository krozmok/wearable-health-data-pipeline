        <mxCell id="srcNote" value="&lt;b&gt;Files as delivered&lt;/b&gt;&lt;br&gt;- 3 CSV files&lt;br&gt;- 3 JSON files per participant&lt;br&gt;- 50 participants, 28 study days" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=4;" vertex="1" parent="src">
          <mxGeometry x="15" y="345" width="200" height="200" as="geometry" />
