        <mxCell id="title" value="PMData - proposed medallion architecture" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="700" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Daily batch run by AWS Step Functions: Glue jobs land the sources in Bronze and clean them into Silver; dbt models Silver into the Gold tables." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#555555;" vertex="1" parent="1">
