          <mxGeometry x="15" y="292" width="200" height="34" as="geometry" />
        </mxCell>
        <mxCell id="slvNote" value="&lt;b&gt;Cleaned and conformed&lt;/b&gt;&lt;br&gt;- Typed and de-duplicated&lt;br&gt;- Keys enforced at the stated grain&lt;br&gt;- Timestamps normalised to UTC-05:00&lt;br&gt;- Stuck-sensor heart-rate readings flagged&lt;br&gt;- sleep flattened into sessions and stages&lt;br&gt;- Firmware parsed from device_label" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=4;" vertex="1" parent="slv">
          <mxGeometry x="15" y="345" width="200" height="200" as="geometry" />
        </mxCell>

