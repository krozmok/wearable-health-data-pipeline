        <mxCell id="brzNote" parent="brz" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=4;" value="&lt;b&gt;Raw, as delivered&lt;/b&gt;&lt;br&gt;- One table per source file type&lt;br&gt;- Append-only, one load per daily batch&lt;br&gt;- No cleaning or type changes&lt;br&gt;- Adds load date and source file&lt;br&gt;- Kept so Silver can be rebuilt" vertex="1">
          <mxGeometry height="200" width="200" x="15" y="345" as="geometry" />
