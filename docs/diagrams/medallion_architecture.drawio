        <mxCell id="gld" value="Gold - consumption" style="swimlane;html=1;startSize=30;fillColor=#FFE599;strokeColor=#D6B656;fontSize=14;fontStyle=1;rounded=1;swimlaneFillColor=#FFFFFF;" vertex="1" parent="1">
