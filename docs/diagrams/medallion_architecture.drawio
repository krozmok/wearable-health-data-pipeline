        </mxCell>
        <mxCell id="conNote" value="&lt;b&gt;Read Gold only&lt;/b&gt;&lt;br&gt;- Daily teams pick up yesterday&#39;s partition after each run&lt;br&gt;- Weekly teams read closed study weeks (is_complete_week)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=4;" vertex="1" parent="con">
          <mxGeometry x="15" y="345" width="200" height="200" as="geometry" />
