        </mxCell>
        <mxCell id="orcNote" value="Each step starts only when the previous one succeeds; a failed step stops the run, so Gold keeps the last good data. The weekly build runs only on the day a study week closes (Wednesday data loaded)." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;spacing=4;" vertex="1" parent="orc">
