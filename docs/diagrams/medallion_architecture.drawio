        <!-- Orchestration -->
        <mxCell id="orc" value="AWS Step Functions - daily state machine" style="swimlane;html=1;startSize=30;fillColor=#F8CECC;strokeColor=#C2185B;fontSize=14;fontStyle=1;rounded=1;swimlaneFillColor=#FFFFFF;" vertex="1" parent="1">
